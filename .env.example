# ============================================================
# RepMon — Environment Variables
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

ANTHROPIC_API_KEY=sk-ant-...

# Google Business Profile (OAuth2 — see docs/API_KEYS.md)
# Path to OAuth2 client credentials JSON from Google Cloud Console
# (APIs & Services → Credentials → "Desktop app" → Download JSON).
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Cached OAuth refresh token after first browser consent (.gitignored).
GOOGLE_OAUTH_TOKEN_PATH=./.google_oauth_token.json

# Yelp Fusion (read-only reviews)
YELP_API_KEY=

# Trustpilot
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=repmon/0.1

# Twitter / X API v2
TWITTER_BEARER_TOKEN=

# Optional MXToolbox API
MXTOOLBOX_API_KEY=

# SMTP (alerts / optional outbound)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

CONFIG_PATH=config.yaml
LOG_LEVEL=INFO
